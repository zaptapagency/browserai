# ===== Application =====
NODE_ENV="development"
APP_NAME="browserai"
APP_URL="http://localhost:3000"

# ===== Core Services =====
# PostgreSQL
DATABASE_URL="postgresql://dev:dev_password@localhost:5432/browserai_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="browserai-dev"
S3_USE_PATH_STYLE="true"

# ===== Authentication (Better Auth) =====
BETTER_AUTH_SECRET="your-secret-min-32-chars-change-me-in-dev"
BETTER_AUTH_URL="http://localhost:3000/auth"
BETTER_AUTH_TRUST_HOST="true"

# GitHub OAuth (for testing; get from GitHub App settings)
GITHUB_OAUTH_ID=""
GITHUB_OAUTH_SECRET=""

# ===== Stripe (Billing) =====
# Use test mode keys (sk_test_*, pk_test_)
STRIPE_SECRET_KEY="sk_test_"
STRIPE_PUBLISHABLE_KEY="pk_test_"
STRIPE_WEBHOOK_SECRET="whsec_"

# ===== Feature Flags =====
# CAPTCHA Solving (default: use mock)
ENABLE_REAL_CAPTCHA_SOLVER="false"
CAPTCHA_SOLVER_TYPE="mock"
CAPTCHA_SOLVER_API_KEY=""

# Proxy Provider (default: use mock)
ENABLE_REAL_PROXY_PROVIDER="false"
PROXY_PROVIDER_TYPE="mock"
PROXY_PROVIDER_API_KEY=""

# Observability
ENABLE_SENTRY="false"
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# Notifications
ENABLE_EMAIL_NOTIFICATIONS="false"
EMAIL_PROVIDER="mock"
SENDGRID_API_KEY=""
SLACK_WEBHOOK_URL=""

# General Features
FEATURE_DEMO_MODE="true"
FEATURE_SKILL_MARKETPLACE="false"
FEATURE_ENTERPRISE_SSO="false"

# ===== API Configuration =====
API_PORT="3000"
API_LOG_LEVEL="debug"

# ===== Worker Configuration =====
WORKER_PORT="8080"
WORKER_MAX_SESSIONS="10"
WORKER_SESSION_TTL_MS="3600000"

# ===== Scheduler Configuration =====
SCHEDULER_PORT="3001"
SCHEDULER_ENABLED="true"

# ===== Rate Limiting =====
RATE_LIMIT_REQUESTS_PER_HOUR="1000"
RATE_LIMIT_REQUESTS_PER_MINUTE="100"
