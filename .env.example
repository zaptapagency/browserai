# ===== Application Environment =====
# "development" | "staging" | "production"
NODE_ENV="development"
APP_ENV="development"
APP_NAME="browserai"
APP_URL="http://localhost:3000"
LOG_LEVEL="debug"

# ===== Database (PostgreSQL) =====
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Local: postgres running via docker-compose
DATABASE_URL="postgresql://dev:dev_password@localhost:5432/browserai_dev"
# Production example: DATABASE_URL="postgresql://prod_user:complex_password@db.production.railway.app:5432/browserai"

# ===== Cache (Redis) =====
# Format: redis://[password]@[host]:[port]/[db]
REDIS_URL="redis://localhost:6379"
# Production example: REDIS_URL="redis://:password@redis.production.railway.app:6379/0"

# ===== Object Storage (S3 / MinIO / AWS S3) =====
# Local development: MinIO (running via docker-compose)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="browserai-dev"
S3_USE_PATH_STYLE="true"
# Production with AWS S3:
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_ACCESS_KEY="AKIA..."
# S3_SECRET_KEY="wJal..."
# S3_BUCKET="browserai-production"
# S3_USE_PATH_STYLE="false"

# ===== Authentication (Better Auth / NextAuth) =====
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Change in production!
BETTER_AUTH_SECRET="your-secret-min-32-chars-change-me-in-dev"
BETTER_AUTH_URL="http://localhost:3000/auth"
BETTER_AUTH_TRUST_HOST="true"

# GitHub OAuth (optional; get from GitHub App settings)
GITHUB_OAUTH_ID=""
GITHUB_OAUTH_SECRET=""

# ===== Billing (Stripe) =====
# Test mode keys: sk_test_*, pk_test_
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_"
STRIPE_PUBLISHABLE_KEY="pk_test_"
STRIPE_WEBHOOK_SECRET="whsec_"
STRIPE_PRODUCT_CREDITS_ID="prod_"

# ===== Sensitive Features (Feature Flags) =====
# These control access to real external providers (proxies, CAPTCHA solving)
# Default to "false" (mock implementation) for safety
# Only enable after understanding legal and ethical implications

# CAPTCHA Solving - default: mock (no solving, token returned as-is)
ENABLE_REAL_CAPTCHA_SOLVER="false"
CAPTCHA_SOLVER_TYPE="mock"
# CAPTCHA_SOLVER_TYPE can be: "mock" | "2captcha" | "deathbycaptcha"
CAPTCHA_SOLVER_API_KEY=""

# Proxy Provider - default: mock (localhost bypass, no real proxy)
ENABLE_REAL_PROXY_PROVIDER="false"
PROXY_PROVIDER_TYPE="mock"
# PROXY_PROVIDER_TYPE can be: "mock" | "brightdata" | "luminati"
PROXY_PROVIDER_API_KEY=""

# ===== Observability =====
# Sentry error tracking
ENABLE_SENTRY="false"
SENTRY_DSN=""

# OpenTelemetry exporter (for metrics/traces)
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# ===== Notifications (Optional) =====
# Email notifications
ENABLE_EMAIL_NOTIFICATIONS="false"
EMAIL_PROVIDER="mock"
# EMAIL_PROVIDER can be: "mock" | "sendgrid" | "resend"
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@browserai.local"

# Slack integration
SLACK_WEBHOOK_URL=""

# ===== Feature Flags (UI/UX) =====
# Enable demo mode (public dashboard access)
FEATURE_DEMO_MODE="true"
# Enable skill marketplace
FEATURE_SKILL_MARKETPLACE="false"
# Enable enterprise SSO (SAML, OIDC)
FEATURE_ENTERPRISE_SSO="false"

# ===== API Service Configuration =====
API_PORT="3001"
API_LOG_LEVEL="debug"
# CORS origins (comma-separated)
API_CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ===== Browser Worker Configuration =====
WORKER_PORT="3000"
WORKER_MAX_SESSIONS="10"
# Session TTL in milliseconds (1 hour = 3600000)
WORKER_SESSION_TTL_MS="3600000"
WORKER_SCREENSHOT_INTERVAL_MS="2000"

# ===== Scheduler Configuration =====
SCHEDULER_PORT="3002"
SCHEDULER_ENABLED="true"
SCHEDULER_CONCURRENCY="5"

# ===== Rate Limiting =====
# Per API key
RATE_LIMIT_REQUESTS_PER_HOUR="10000"
RATE_LIMIT_REQUESTS_PER_MINUTE="1000"

# ===== Security =====
# HTTPS enforcement in production
ENFORCE_HTTPS="false"
# Enable rate limiting
ENABLE_RATE_LIMITING="true"
