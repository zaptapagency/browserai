{
  "name": "@browserai/db",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.ts'",
    "clean": "rm -rf dist",
    "migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate:pg",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@browserai/core": "workspace:*",
    "drizzle-kit": "^0.20.0",
    "typescript": "^5.4.5",
    "tsx": "^4.7.0"
  }
}
