{
  "name": "@browserai/api",
  "version": "0.1.0",
  "private": true,
  "description": "BrowserAI control plane API (NestJS)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "zod": "^3.22.4",
    "@browserai/core": "workspace:*",
    "@browserai/config": "workspace:*",
    "@browserai/db": "workspace:*",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@types/node": "^20.11.5",
    "@types/express": "^4.17.21",
    "typescript": "^5.4.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2"
  }
}
