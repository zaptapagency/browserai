{
  "name": "@browserai/browser-worker",
  "version": "0.1.0",
  "private": true,
  "description": "BrowserAI Playwright runtime and session executor",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "playwright": "^1.40.0",
    "express": "^4.18.2",
    "pino": "^8.17.2",
    "ws": "^8.16.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "@aws-sdk/client-s3": "^3.523.0",
    "@browserai/core": "workspace:*",
    "@browserai/config": "workspace:*",
    "@browserai/providers": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/jsonwebtoken": "^9.0.5",
    "typescript": "^5.4.5",
    "tsx": "^4.7.0",
    "vitest": "^1.3.1"
  }
}
